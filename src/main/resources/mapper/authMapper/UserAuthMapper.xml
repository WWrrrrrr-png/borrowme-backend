<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.borrowme.auth.UserAuthMapper">

	<select id = "findByEmail" resultType="com.borrowme.auth.dto.UserDto" >
		SELECT id,email,password,name,gender,phone,status,created_at
		FROM user
		WHERE email = #{email}
	</select>
	
	<select id="findById" resultType="com.borrowme.auth.dto.UserDto">
	   SELECT id,email,password,name,gender,phone,status,created_at
	   FROM user
	   WHERE id = #{id}
	</select>
	
	<insert id="insert" parameterType="com.borrowme.auth.dto.UserDto">
	   INSERT INTO user (email,password,name,gender,phone,status)
	   VALUES (#{email}, #{password}, #{name}, #{gender}, #{phone}, 'ACTIVE')
	</insert>
	
	<update id="anonymizeById">
	    UPDATE user
	    SET email = #{email},
	        password = #{password},
	        name = '탈퇴한 회원',
	        status = 'WITHDRAWN'
	    WHERE id = #{id}
	</update>

</mapper>